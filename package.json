{
  "name": "techselect",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.x"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev -w @techselect/frontend",
    "build": "npm run build -w @techselect/frontend",
    "start": "npm run start -w @techselect/frontend",
    "lint": "eslint",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "test:unit": "npm run test:unit -w @techselect/backend",
    "test:db": "npm run test:db -w @techselect/backend",
    "test:e2e": "npm run test:e2e -w @techselect/frontend",
    "test:e2e:ui": "npm run test:e2e:ui -w @techselect/frontend",
    "test:m2": "npm run test:m2 -w @techselect/frontend",
    "db:generate": "npm run db:generate -w @techselect/backend",
    "db:migrate": "npm run db:migrate -w @techselect/backend",
    "db:studio": "npm run db:studio -w @techselect/backend",
    "db:seed": "npm run db:seed -w @techselect/backend",
    "db:erd": "npm run db:erd -w @techselect/backend",
    "db:status": "npm run db:status -w @techselect/backend",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "eval": "npm run eval -w @techselect/backend",
    "embed:backfill": "npm run embed:backfill -w @techselect/backend",
    "match:warm": "npm run match:warm -w @techselect/backend",
    "bench:match": "npm run bench:match -w @techselect/backend",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  }
}
