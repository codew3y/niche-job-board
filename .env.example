# ── Database ────────────────────────────────────────────────────────────────
# Local Supabase (npm run db:start). Port is fixed by supabase/config.toml.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Hosted: Dashboard → Connect → ORMs → Drizzle.
# Use the SESSION pooler (port 5432). The transaction pooler (6543) does not support the
# prepared statements drizzle-kit uses and migrations fail confusingly.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Supabase API ────────────────────────────────────────────────────────────
# Local values below are the standard local-dev keys: identical on every local Supabase
# install and useless against a hosted project. Hosted values: Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key>"

# BYPASSES ALL RLS. Server-side only — never NEXT_PUBLIC_, never logged, never in the browser.
SUPABASE_SERVICE_ROLE_KEY="<service role key>"

# Absolute base URL for OAuth callbacks and email links. On Vercel this falls back to the
# per-deploy VERCEL_URL, so preview deploys do not send users back to production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Optional. Where people write about their data or the service; shown on /privacy and in the
# footer when set. Leave blank to show neither.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Matching (optional) ─────────────────────────────────────────────────────
# Google Gemini: embeddings and the re-ranker. Unset, match feeds show their empty state.
GEMINI_API_KEY=
# Operator secret, 16+ characters: guards POST /api/match/warm and unlocks the detailed
# /api/health response (Authorization: Bearer <value>). Unset, both refuse.
MATCH_WARM_SECRET=

# ── OAuth providers ─────────────────────────────────────────────────────────
# Register this callback with BOTH Google and GitHub — it is SUPABASE's endpoint, not the
# app's. Supabase holds the secret, exchanges the code, then redirects to /auth/callback.
#   local:  http://127.0.0.1:54321/auth/v1/callback
#   hosted: https://<project-ref>.supabase.co/auth/v1/callback
# Providers exact-match this, so local and production need SEPARATE OAuth apps.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=""
# "Connect LinkedIn" (migration 0021). From a LinkedIn app with the "Sign In with LinkedIn
# using OpenID Connect" product; then set enabled = true under [auth.external.linkedin_oidc]
# in supabase/config.toml and restart Supabase.
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_SECRET=

# ─────────────────────────── email (optional) ───────────────────────────
# Everything below is optional and fails SILENTLY when absent: no mail is sent, and no
# user-facing action breaks. Check /api/health on a deploy to see what is actually set.

# resend.com/api-keys. Sending access is enough — it never needs full access.
RESEND_API_KEY=

# Who mail appears to come from. Leave BLANK to use Resend's shared sender, which needs no
# domain and can ONLY deliver to the email address on your Resend account. Set this to an
# address on a domain verified at resend.com/domains to reach anyone else.
EMAIL_FROM=

# ─────────────────────────── admin (optional) ───────────────────────────
# Who can open the reports queue at /dashboard/admin: comma-separated sign-in email addresses.
# Server-only. Unset means nobody.
ADMIN_EMAILS=

# ─────────────────────────── error tracking (optional) ───────────────────────────
# Sentry. Both from the same Sentry project (Settings → Client Keys (DSN)). Unset means no error
# tracking and no Sentry code in the browser. Errors only: no tracing, no session replay, and
# reports are scrubbed of cookies, headers, query strings and user identity before sending.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
